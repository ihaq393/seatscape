// Edunet Foundation — Simple Seat Reservation
// Minimal schema: 3 roles (DEVELOPER, ADMIN, EMPLOYEE), single office, seats + bookings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3 roles: DEVELOPER | ADMIN | EMPLOYEE
model User {
  id              String   @id @default(cuid())
  employeeId      String   @unique
  name            String
  email           String   @unique
  phone           String?
  passwordHash    String
  role            String   @default("EMPLOYEE")
  avatarColor     String?
  jobTitle        String?
  designation     String?
  photoUrl        String?
  department      String?
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings  Booking[]
  approvals Booking[] @relation("ApprovalBy")

  @@index([role])
}

model Seat {
  id          String   @id @default(cuid())
  number      String   @unique // S1..S8
  label       String?
  isEmergency Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  // null = inherit global auto-approval setting; true = force auto-approve; false = force manual approval
  autoApprove Boolean?
  posX        Int      @default(0)
  posY        Int      @default(0)
  zone        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

// status: PENDING | APPROVED | REJECTED | CANCELLED | CHECKED_IN | COMPLETED
// type:   NORMAL | LATE
model Booking {
  id              String   @id @default(cuid())
  reference       String   @unique
  userId          String
  seatId          String
  date            DateTime
  purpose         String
  justification   String?
  type            String   @default("NORMAL")
  status          String   @default("APPROVED")
  expectedCheckIn String   @default("10:00")
  expectedCheckOut String  @default("18:00")
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  cancelledReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat       Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("ApprovalBy", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([seatId])
  @@index([date])
  @@index([status])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// Signup requests from the public signup form — admin approves/rejects
// status: PENDING | APPROVED | REJECTED
model SignupRequest {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  employeeId  String   @unique
  phone       String?
  jobTitle    String?
  designation String?
  department  String?
  passwordHash String  // stored hashed; used to create the account on approval
  status      String   @default("PENDING")
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Editable homepage content + theme — managed by Developer role
model Customization {
  id              String @id @default(cuid())
  heroTitle       String @default("Reserve your seat here")
  heroSubtitle    String @default("Check live seat availability and book your desk in seconds.")
  heroBadge       String @default("Edunet Foundation")
  loginLabel      String @default("Login to book")
  accentColor     String @default("#10b981")
  officeOpenTime  String @default("09:00")
  officeCloseTime String @default("19:00")
  brandName       String @default("SeatScape")
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
